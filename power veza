        bar.style.background = `linear-gradient(to right, ${color}, ${adjustColor(color, -20)}, ${color})`;
    });
    
    const taskbar = document.getElementById('taskbar');
    taskbar.style.height = tbHeight + 'px';
    const rgba = hexToRgba(color, 0.85);
    taskbar.style.background = `linear-gradient(to bottom, ${rgba}, ${hexToRgba(color, 0.95)})`;
    
    document.querySelectorAll('.window').forEach(w => {
        w.style.borderRadius = border;
    });
    
    const desktop = document.getElementById('desktop');
    const bgs = {
        aurora: `radial-gradient(ellipse at 20% 50%, rgba(120, 180, 255, 0.3) 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, rgba(100, 200, 255, 0.2) 0%, transparent 50%), linear-gradient(to bottom, #0f4b6e, #2a7da2, #5fa8c5, #8ecae6)`,
        dark: `linear-gradient(to bottom, #0a0a0a, #1a1a2e, #16213e)`,
        ocean: `linear-gradient(to bottom, #006994, #0099cc, #00bfff)`,
        sunset: `linear-gradient(to bottom, #2d1b4e, #b02e5e, #f9a825)`
    };
    desktop.style.background = bgs[bg] || bgs.aurora;
    
    document.querySelectorAll('.settings-tab.active').forEach(t => {
        t.style.background = color;
        t.style.borderColor = color;
    });
}

function adjustColor(hex, amount) {
    const num = parseInt(hex.replace('#', ''), 16);
    const r = Math.max(0, Math.min(255, (num >> 16) + amount));
    const g = Math.max(0, Math.min(255, ((num >> 8) & 0x00FF) + amount));
    const b = Math.max(0, Math.min(255, (num & 0x0000FF) + amount));
    return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
}

function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3), 16);
    const g = parseInt(hex.slice(3,5), 16);
    const b = parseInt(hex.slice(5,7), 16);
    return `rgba(${r},${g},${b},${alpha})`;
}

// Keyboard shortcuts
document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 's') {
        const vs = document.getElementById('win-vscode');
        if (vs.style.display !== 'none') {
            e.preventDefault();
            const term = document.getElementById('vs-terminal');
            const line = document.createElement('div');
            line.className = 'vs-terminal-line';
            line.style.color = '#0f0';
            line.textContent = `[${new Date().toLocaleTimeString()}] ✓ تم الحفظ بنجاح!`;
            term.appendChild(line);
            term.scrollTop = term.scrollHeight;
        }
    }
    if (e.key === 'Escape') {
        closePvPlayer();
    }
});

// Initialize
renderFiles();
</script>

