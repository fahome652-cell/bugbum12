<script>
// Clock
function updateClock() {
    const now = new Date();
    const time = now.toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'});
    const date = now.toLocaleDateString('ar-SA', {month:'short', day:'numeric'});
    document.getElementById('clock').innerHTML = `<div>${time}</div><div style="font-size:10px; text-align:center;">${date}</div>`;
}
setInterval(updateClock, 1000);
updateClock();

// Start Menu
function toggleStart() {
    document.getElementById('startMenu').classList.toggle('show');
}
document.addEventListener('click', (e) => {
    if (!e.target.closest('.start-menu') && !e.target.closest('.start-btn')) {
        document.getElementById('startMenu').classList.remove('show');
    }
});

// Window Management
let zIndex = 1000;
let minimized = {};

function openWindow(id) {
    const win = document.getElementById('win-' + id);
    if (!win) return;
    win.style.display = 'flex';
    win.classList.add('active');
    zIndex++;
    win.style.zIndex = zIndex;
    if (minimized[id]) {
        delete minimized[id];
        updateTaskbar();
    } else if (!win.dataset.opened) {
        addTaskbarItem(id);
        win.dataset.opened = 'true';
        const w = parseInt(win.style.width) || 600;
        const h = parseInt(win.style.height) || 400;
        win.style.top = (window.innerHeight/2 - h/2 - 20) + 'px';
        win.style.left = (window.innerWidth/2 - w/2) + 'px';
    }
    updateTaskbar();
}

function closeWindow(id) {
    const win = document.getElementById('win-' + id);
    win.style.display = 'none';
    win.classList.remove('active');
    delete minimized[id];
    removeTaskbarItem(id);
    win.dataset.opened = '';
}

function minimizeWindow(id) {
    const win = document.getElementById('win-' + id);
    win.style.display = 'none';
    minimized[id] = true;
    updateTaskbar();
}

function maximizeWindow(id) {
    const win = document.getElementById('win-' + id);
    win.classList.toggle('maximized');
}

function addTaskbarItem(id) {
    if (document.getElementById('tb-' + id)) return;
    const names = {fm: 'My Computer', vscode: 'VS Code', settings: 'Settings'};
    const icons = {fm: '🖥️', vscode: '💻', settings: '⚙️'};
    const div = document.createElement('div');
    div.className = 'taskbar-item';
    div.id = 'tb-' + id;
    div.innerHTML = `<span style="font-size:14px;">${icons[id]}</span><span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${names[id]}</span>`;
    div.onclick = () => {
        const win = document.getElementById('win-' + id);
        if (win.style.display === 'none' || minimized[id]) {
            win.style.display = 'flex';
            delete minimized[id];
            zIndex++;
            win.style.zIndex = zIndex;
        } else if (win.style.zIndex == zIndex) {
            minimizeWindow(id);
        } else {
            zIndex++;
            win.style.zIndex = zIndex;
        }
        updateTaskbar();
    };
    document.getElementById('taskbar-items').appendChild(div);
    updateTaskbar();
}

function removeTaskbarItem(id) {
    const el = document.getElementById('tb-' + id);
    if (el) el.remove();
    updateTaskbar();
}

function updateTaskbar() {
    document.querySelectorAll('.taskbar-item').forEach(el => {
        const id = el.id.replace('tb-', '');
        const win = document.getElementById('win-' + id);
        if (win && win.style.display !== 'none' && !minimized[id] && win.style.zIndex == zIndex) {
            el.classList.add('active');
        } else {
            el.classList.remove('active');
        }
    });
}

// Drag
let dragInfo = {};
function startDrag(e, id) {
    if (e.target.closest('.win-btn')) return;
    const win = document.getElementById(id);
    if (win.classList.contains('maximized')) return;
    dragInfo = {
        id: id,
        offsetX: e.clientX - win.offsetLeft,
        offsetY: e.clientY - win.offsetTop
    };
    document.addEventListener('mousemove', onDrag);
    document.addEventListener('mouseup', stopDrag);
    zIndex++;
    win.style.zIndex = zIndex;
    updateTaskbar();
}

function onDrag(e) {
    if (!dragInfo.id) return;
    const win = document.getElementById(dragInfo.id);
    let x = e.clientX - dragInfo.offsetX;
    let y = e.clientY - dragInfo.offsetY;
    x = Math.max(0, Math.min(x, window.innerWidth - 100));
    y = Math.max(0, Math.min(y, window.innerHeight - 100));
    win.style.left = x + 'px';
    win.style.top = y + 'px';
}

function stopDrag() {
    dragInfo = {};
    document.removeEventListener('mousemove', onDrag);
    document.removeEventListener('mouseup', stopDrag);
}

// File Manager - Drag & Drop
let files = [];
let currentPath = 'Desktop';

function setFmPath(path, el) {
    currentPath = path;
    const names = {Desktop: 'سطح المكتب / Desktop', Videos: 'الفيديوهات / Videos', Pictures: 'الصور / Pictures', Music: 'الصوتيات / Music', Documents: 'المستندات / Documents'};
    document.getElementById('fm-path').textContent = names[path] || path;
    document.querySelectorAll('.fm-item').forEach(i => i.classList.remove('active'));
    if (el) el.classList.add('active');
    renderFiles();
}

function handleFiles(input) {
    const newFiles = Array.from(input.files);
    processFiles(newFiles);
    input.value = '';
}

function processFiles(newFiles) {
    newFiles.forEach(file => {
        const path = file.type.startsWith('video/') ? 'Videos' : 
                     file.type.startsWith('image/') ? 'Pictures' : 
                     file.type.startsWith('audio/') ? 'Music' : 'Documents';
        files.push({
            name: file.name,
            type: file.type,
            path: path,
            url: URL.createObjectURL(file),
            size: (file.size / 1024 / 1024).toFixed(2) + ' MB'
        });
    });
    renderFiles();
    // Switch to relevant folder if FM is open
    if (document.getElementById('win-fm').style.display !== 'none') {
        const first = files[files.length - 1];
        if (first) {
            const pathMap = {'Videos':1, 'Pictures':2, 'Music':3, 'Documents':4};
            const idx = pathMap[first.path] || 0;
            const items = document.querySelectorAll('.fm-item');
            if (items[idx]) items[idx].click();
        }
    }
}

// Desktop Drag & Drop
function handleDragOver(e) {
    e.preventDefault();
    e.stopPropagation();
    document.getElementById('desktop').classList.add('drag-over');
}

function handleDragLeave(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!e.relatedTarget || !e.relatedTarget.closest('.desktop')) {
        document.getElementById('desktop').classList.remove('drag-over');
    }
}

function handleDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    document.getElementById('desktop').classList.remove('drag-over');
    const droppedFiles = Array.from(e.dataTransfer.files);
    if (droppedFiles.length > 0) {
        processFiles(droppedFiles);
        openWindow('fm');
    }
}

function renderFiles() {
    const grid = document.getElementById('fileGridContent');
    const filtered = files.filter(f => f.path === currentPath);
    document.getElementById('fileCount').textContent = filtered.length + ' عنصر';
    if (filtered.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; color:#999; padding:50px; font-size:14px;">📂 لا توجد ملفات هنا<br><span style="font-size:12px;">اسحب ملفات من جهازك للسطح</span></div>';
        return;
    }
    grid.innerHTML = filtered.map(f => {
        let preview = '';
        if (f.type.startsWith('image/')) {
            preview = `<img src="${f.url}" style="width:80px;height:80px;object-fit:cover;">`;
        } else if (f.type.startsWith('video/')) {
            preview = `<video src="${f.url}" style="width:80px;height:80px;object-fit:cover;"></video>`;
        } else if (f.type.startsWith('audio/')) {
            preview = `<div class="file-type-icon">🎵</div>`;
        } else {
            preview = `<div class="file-type-icon">📄</div>`;
        }
        return `
        <div class="file-card" onclick="openPvPlayer('${f.url}', '${f.type}', '${f.name}')" title="${f.name} (${f.size})">
            ${preview}
            <div class="file-name">${f.name}</div>
        </div>`;
    }).join('');
}

// Power Veza Media Player
let pvMedia = null;
let pvPlaying = false;
let pvUpdateInterval = null;

function openPvPlayer(url, type, name) {
    const player = document.getElementById('pvPlayer');
    const body = document.getElementById('pvBody');
    const controls = document.getElementById('pvControls');
    const title = document.getElementById('pvTitle');
    
    title.textContent = name;
    
    if (type.startsWith('image/')) {
        body.innerHTML = `<img src="${url}" style="max-width:100%; max-height:70vh; display:block; margin:0 auto;">`;
        controls.style.display = 'none';
    } else if (type.startsWith('video/')) {
        body.innerHTML = `<video id="pvMedia" src="${url}" style="max-width:100%; max-height:70vh; display:block; margin:0 auto;"></video>`;
        controls.style.display = 'flex';
        pvMedia = document.getElementById('pvMedia');
        pvMedia.volume = 0.8;
        pvMedia.onended = () => {
            pvPlaying = false;
            document.getElementById('pvPlayBtn').textContent = '▶';
        };
        pvMedia.onloadedmetadata = () => updatePvTime();
    } else if (type.startsWith('audio/')) {
        body.innerHTML = `<div style="text-align:center; padding:40px 20px;"><div style="font-size:64px; margin-bottom:20px;">🎵</div><audio id="pvMedia" src="${url}" style="width:100%;"></audio></div>`;
        controls.style.display = 'flex';
        pvMedia = document.getElementById('pvMedia');
        pvMedia.volume = 0.8;
        pvMedia.onended = () => {
            pvPlaying = false;
            document.getElementById('pvPlayBtn').textContent = '▶';
        };
        pvMedia.onloadedmetadata = () => updatePvTime();
    }
    
    player.classList.add('show');
    
    if (pvUpdateInterval) clearInterval(pvUpdateInterval);
    pvUpdateInterval = setInterval(() => {
        if (pvMedia && !pvMedia.paused) {
            updatePvTime();
            if (pvMedia.duration) {
                const pct = (pvMedia.currentTime / pvMedia.duration) * 100;
                document.getElementById('pvProgressFill').style.width = pct + '%';
            }
        }
    }, 200);
}

function closePvPlayer() {
    document.getElementById('pvPlayer').classList.remove('show');
    if (pvMedia) {
        pvMedia.pause();
        pvMedia = null;
    }
    pvPlaying = false;
    if (pvUpdateInterval) clearInterval(pvUpdateInterval);
    document.getElementById('pvPlayBtn').textContent = '▶';
}

function togglePlay() {
    if (!pvMedia) return;
    if (pvMedia.paused) {
        pvMedia.play();
        pvPlaying = true;
        document.getElementById('pvPlayBtn').textContent = '⏸';
    } else {
        pvMedia.pause();
        pvPlaying = false;
        document.getElementById('pvPlayBtn').textContent = '▶';
    }
}

function skip(seconds) {
    if (!pvMedia) return;
    pvMedia.currentTime = Math.max(0, Math.min(pvMedia.duration || 0, pvMedia.currentTime + seconds));
    updatePvTime();
}

function seek(e) {
    if (!pvMedia || !pvMedia.duration) return;
    const rect = document.getElementById('pvProgress').getBoundingClientRect();
    const pct = (e.clientX - rect.left) / rect.width;
    pvMedia.currentTime = pct * pvMedia.duration;
    updatePvTime();
}

function updatePvTime() {
    if (!pvMedia) return;
    const cur = formatTime(pvMedia.currentTime || 0);
    const dur = formatTime(pvMedia.duration || 0);
    document.getElementById('pvTime').textContent = cur + ' / ' + dur;
}

function formatTime(s) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
}

function setVolume() {
    if (!pvMedia) return;
    pvMedia.volume = document.getElementById('pvVolume').value / 100;
}

function toggleFullscreen() {
    const player = document.getElementById('pvPlayer');
    if (!document.fullscreenElement) {
        player.requestFullscreen().catch(() => {});
    } else {
        document.exitFullscreen();
    }
}

